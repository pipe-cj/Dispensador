<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">

    <TextView android:id="@+id/bannerBajo" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:visibility="gone"
        android:background="@color/alerta_fondo" android:textColor="@color/alerta"
        android:padding="12dp" android:layout_marginBottom="16dp"
        android:text="Queda poca comida. Recarga el dispensador pronto."/>

    <com.google.android.material.chip.Chip android:id="@+id/chipEstado"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:checkable="false" android:text="Sin conexión"/>

    <FrameLayout android:layout_width="200dp" android:layout_height="200dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="12dp">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progresoNivel" android:layout_width="200dp" android:layout_height="200dp"
            android:max="100" app:indicatorSize="200dp" app:trackThickness="14dp"
            app:indicatorColor="@color/teal"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/txtNivel" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0%"
                android:textSize="44sp" android:textStyle="bold" android:textColor="@color/ink"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="de comida" android:textColor="#5B6785"/>
        </LinearLayout>
    </FrameLayout>

    <TextView android:id="@+id/txtUltima" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center"
        android:layout_marginTop="12dp" android:textColor="#5B6785"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:text="Tamaño de la porción"
        android:textStyle="bold" android:textColor="@color/ink"/>

    <com.google.android.material.chip.ChipGroup android:id="@+id/grupoPorcion"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:singleSelection="true" app:selectionRequired="true">
        <com.google.android.material.chip.Chip android:id="@+id/chipChica"
            style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Chica"/>
        <com.google.android.material.chip.Chip android:id="@+id/chipMediana"
            style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:checked="true" android:text="Mediana"/>
        <com.google.android.material.chip.Chip android:id="@+id/chipGrande"
            style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Grande"/>
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.button.MaterialButton android:id="@+id/btnDispensar"
        android:layout_width="match_parent" android:layout_height="64dp"
        android:layout_marginTop="16dp" android:text="Dispensar ahora"
        android:textSize="18sp" app:backgroundTint="@color/teal"/>
</LinearLayout>
</ScrollView>
